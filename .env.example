# ===== Infraestructura local (Docker Compose) =====
POSTGRES_DB=catalog_db
POSTGRES_USER=catalog_user
POSTGRES_PASSWORD=catalog_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# ===== Servicio en Docker (docker compose --profile app up -d --build) =====
APP_PORT=8080

# Secreto del JWT (OBLIGATORIO). Base64, minimo 64 bytes.
# Generarlo con: openssl rand -base64 64 | tr -d '\n'   (service-turns usa el mismo valor)
JWT_SECRET=

# ===== Integracion con la catedra (obligatoria para sincronizar el catalogo) =====
# Los valores los informa la catedra y salen de la cuenta tecnica del proyecto (ver README).
CATEDRA_API_BASE_URL=
CATEDRA_JWT_TOKEN=
CATEDRA_REDIS_HOST=
CATEDRA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=
CATEDRA_KAFKA_CONSUMER_GROUP_ID=
CATEDRA_KAFKA_CATALOG_TOPIC=

# ===== Opcionales (tienen valor por defecto) =====
# Reconciliacion de versiones al arrancar y de forma periodica (en Docker esta activa por defecto)
# CATALOG_RECONCILIATION_ENABLED=true
# CATALOG_RECONCILIATION_INTERVAL_MS=300000
# Origenes CORS permitidos, separados por comas. Vacio = ninguno (la app Android no es un navegador)
# CORS_ALLOWED_ORIGINS=
# Tiempos de espera de la API de la catedra
# CATEDRA_API_CONNECT_TIMEOUT_MS=5000
# CATEDRA_API_READ_TIMEOUT_MS=10000
# Hash de contrasenas Argon2id (minimos recomendados por OWASP; por debajo de estos valores el servicio no arranca)
# PASSWORD_ARGON2_MEMORY_KIB=19456
# PASSWORD_ARGON2_ITERATIONS=2
# PASSWORD_ARGON2_PARALLELISM=1