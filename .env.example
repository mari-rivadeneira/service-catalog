# Configuracion de Base de Datos PostgreSQL
POSTGRES_DB=catalog_db
POSTGRES_USER=catalog_user
POSTGRES_PASSWORD=catalog_password
POSTGRES_PORT=5432

# Configuracion de Redis
REDIS_PORT=6379

# Catedra
CATEDRA_API_BASE_URL=
CATEDRA_JWT_TOKEN=

# Redis de catedra
CATEDRA_REDIS_HOST=localhost
CATEDRA_REDIS_PORT=6379

# Solo para la Redis real de catedra
# SPRING_DATA_REDIS_USERNAME=
# SPRING_DATA_REDIS_PASSWORD=

# Kafka de catedra (en local apunta al contenedor del compose).
# En el entorno real: kafkaBootstrapServers, kafkaConsumerGroupId y kafkaCatalogTopic de la integracion.
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CATEDRA_KAFKA_CONSUMER_GROUP_ID=alumnos-local-catalog
CATEDRA_KAFKA_CATALOG_TOPIC=catedra.catalog.local

# Reconciliacion de versiones (true para activarla al correr el servicio)
CATALOG_RECONCILIATION_ENABLED=false
CATALOG_RECONCILIATION_INTERVAL_MS=300000

# Secreto del JWT (Base64, minimo 64 bytes). Generarlo con: openssl rand -base64 64. service-turns usa el mismo valor.
JWT_SECRET=

# CORS: origenes permitidos separados por comas. Vacio = no se permite ningun origen
# (lo correcto si el unico cliente es la app Android, que no es un navegador).
CORS_ALLOWED_ORIGINS=